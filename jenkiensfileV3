pipeline {
    agent any
    environment {
        VENV = "venv"
        DEPLOY_PORT = "5000"
        APP_NAME = "flask-app"
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo "Checked out branch: ${env.BRANCH_NAME ?: 'default'}"
            }
        }
        stage('Build') {
            steps {
                sh 'python3 -m venv $VENV'
                sh '''
                    . $VENV/bin/activate
                    pip install --upgrade pip
                    pip install -r requirements.txt
                '''
                echo 'Build complete: virtual environment ready and dependencies installed.'
            }
        }
        stage('Test') {
            steps {
                sh '''
                    . $VENV/bin/activate
                    pip install pytest pytest-cov
                    pytest tests/ --tb=short --junitxml=test-results.xml || true
                '''
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'test-results.xml'
                }
            }
        }
        stage('Deploy') {
    steps {
        sh '''
            # Kill any existing instance
            pkill -f "python3 app.py" || true

            cd /var/jenkins_home/workspace/trail2
            . venv/bin/activate

            # Use bash explicitly so disown works
            bash -c "nohup python3 app.py > flask.log 2>&1 & echo \$! > app.pid && disown \$!"

            sleep 10
            if curl -sf http://localhost:$DEPLOY_PORT > /dev/null; then
                echo "App is live on port $DEPLOY_PORT"
            else
                echo "App did not respond — check flask.log"
                cat flask.log
                exit 1
            fi
        '''
    }
}
}
