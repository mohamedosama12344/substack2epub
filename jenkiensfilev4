pipeline {
    agent any
    environment {
        VENV = "venv"
        DEPLOY_PORT = "5000"
        APP_NAME = "flask-app"
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo "Checked out branch: ${env.BRANCH_NAME ?: 'default'}"
            }
        }
        stage('Build') {
            steps {
                sh 'python3 -m venv $VENV'
                sh '''
                    . $VENV/bin/activate
                    pip install --upgrade pip
                    pip install -r requirements.txt
                '''
                echo 'Build complete: virtual environment ready and dependencies installed.'
            }
        }
        stage('Test') {
            steps {
                sh '''
                    . $VENV/bin/activate
                    pip install pytest pytest-cov
                    pytest tests/ --tb=short --junitxml=test-results.xml || true
                '''
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'test-results.xml'
                }
            }
        }
        stage('Deploy') {
            steps {
                sh '''
                    pkill -f "python3 app.py" || true
                    cd /var/jenkins_home/workspace/trail2
                    . venv/bin/activate

                    export JENKINS_NODE_COOKIE=dontKillMe
                    nohup python3 app.py > flask.log 2>&1 &
                    APP_PID=$!
                    echo $APP_PID > app.pid

                    sleep 5
                    if kill -0 $APP_PID 2>/dev/null; then
                        HOST_IP=$(python3 - <<EOF
import struct, socket
with open("/proc/net/route") as f:
    for line in f.readlines()[1:]:
        fields = line.strip().split()
        if fields[1] == "00000000":
            gateway = socket.inet_ntoa(struct.pack("<L", int(fields[2], 16)))
            iface = fields[0]
            import subprocess
            result = subprocess.check_output(["cat", "/proc/net/fib_trie"]).decode()
            break
    # Get host IP from hostname
    print(socket.gethostbyname(socket.gethostname()))
EOF
)
                        echo "=========================================="
                        echo "App started successfully with PID $APP_PID"
                        echo "Access your app at: http://$HOST_IP:5000"
                        echo "=========================================="
                    else
                        echo "App failed to start"
                        cat flask.log
                        exit 1
                    fi
                '''
            }
        }
    }
    post {
        success {
            sh '''
                HOST_IP=$(python3 - <<EOF
import socket
print(socket.gethostbyname(socket.gethostname()))
EOF
)
                echo "=========================================="
                echo "Pipeline succeeded: Flask app deployed!"
                echo "Access your app at: http://$HOST_IP:5000"
                echo "=========================================="
            '''
        }
        failure {
            sh 'cat /var/jenkins_home/workspace/trail2/flask.log || true'
            echo 'Pipeline failed! Check logs above.'
        }
        always {
            archiveArtifacts artifacts: 'flask.log', allowEmptyArchive: true
        }
    }
}
