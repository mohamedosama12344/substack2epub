pipeline {
    agent any

    environment {
        VENV = "venv"
    }

    stages {


        stage('Check Python Environment') {
            steps {
                sh 'python3 --version'
                sh 'pip3 --version'
            }
        }

        stage('Create Virtual Environment') {
            steps {
                sh 'python3 -m venv $VENV'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                    . $VENV/bin/activate

                    pip install --upgrade pip

                    if [ -f requirements.txt ]; then
                        pip install -r requirements.txt
                    else
                        echo "requirements.txt not found"
                    fi
                '''
            }
        }

        stage('Run Application Test') {
            steps {
                sh '''
                    . $VENV/bin/activate

                    python3 --help

                    echo "Basic Python execution successful"
                '''
            }
        }

        stage('Repository Validation') {
            steps {
                sh '''
                    echo "Checking repository files..."

                    ls -la

                    if [ -f setup.py ]; then
                        echo "setup.py exists"
                    fi

                    if [ -f pyproject.toml ]; then
                        echo "pyproject.toml exists"
                    fi
                '''
            }
        }

        stage('Build Complete') {
            steps {
                echo 'Pipeline finished successfully!'
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: Pipeline executed correctly.'
        }

        failure {
            echo 'FAILED: Pipeline execution failed.'
        }

        always {
            cleanWs()
        }
    }
}
